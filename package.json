{
  "name": "fleetflow",
  "version": "1.0.0",
  "description": "Real-time dispatch engine for field operations: constraint-aware job assignment, event-sourced job lifecycle, geofenced arrivals and live WebSocket updates.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ci": "npm run typecheck && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ndanetaadmire-debug/fleetflow.git"
  },
  "author": "Admire T. Ndaneta",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ndanetaadmire-debug/fleetflow/issues"
  },
  "homepage": "https://github.com/ndanetaadmire-debug/fleetflow#readme",
  "dependencies": {
    "@fastify/websocket": "^11.3.7",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "ws": "^8.23.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  }
}
